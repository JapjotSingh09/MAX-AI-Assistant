<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE network policy: HTTPS ONLY.

  Cleartext (plain http://) is NOT permitted here. The previous single config
  allowed it everywhere so a debug build could reach a PC on the LAN; that
  policy has been split, and cleartext is now only allowed in the debug variant
  (src/debug/res/xml/network_security_config.xml), which is not in the release
  APK at all.

  So a release build cannot silently talk to a laptop or to the emulator alias.
  This mirrors the release-time check that rejects a non-https MAX_API_BASE_URL.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Only the system CA store: no user-installed or debug CAs. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
