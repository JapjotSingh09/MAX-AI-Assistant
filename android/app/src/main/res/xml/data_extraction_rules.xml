<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules.

  `android:allowBackup="false"` already stops cloud backup, but Android 12
  introduced a separate device-TO-DEVICE transfer path. This file closes that
  too, so the encrypted session token and the local notes store cannot be moved
  to another device even by the user.

  Nothing is ever backed up or transferred, including crash logs and settings.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
