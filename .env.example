# Copy to .env and fill in. NEVER commit .env. Never put these values in the Android app.

# ---- Hosting (Render and most hosts inject PORT themselves; do NOT set it locally) ----
# PORT=
# NODE_ENV=  (leave unset for local dev; the host sets NODE_ENV=production)

# ---- Database (reference backend: PostgreSQL via Drizzle) ----
# Local dev default. On Render, replace with your Postgres URL (dashboard -> Environment).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public URL of the backend (used in email links). Leave empty to use the request origin.
# On Render, set this to your service URL, e.g. https://<your-app>.onrender.com
APP_URL=

# ---- Supabase (only if you deploy the Supabase variant, see supabase/) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI gateway ----
# AI_PROVIDER: openai | openrouter | gemini | custom   (custom also needs AI_BASE_URL)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Optional fallback provider, tried when the primary one fails
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
# How many extra model round-trips one request may spend on tool calling. Each
# round costs money, so this is a hard ceiling. 0 leaves MAX on its plain
# prompt-only path (still fully functional, just less accurate at picking
# tools). Keep it between 1 and 3.
AI_MAX_TOOL_ROUNDS=2

# ---- Email (EMAIL_PROVIDER: console for dev, smtp for production) ----
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MAX <no-reply@yourdomain.com>"
REQUIRE_EMAIL_VERIFICATION=false

# ---- Rate limits / quotas (tune for your plan and budget) ----
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AI_PER_DAY=200
RATE_LIMIT_VOICE_PER_MINUTE=20
RATE_LIMIT_AUTOMATION_CREATES_PER_DAY=50
RATE_LIMIT_EXPENSIVE_PER_MINUTE=5
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_LENGTH=200
